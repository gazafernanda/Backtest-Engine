# Copy this file to `.env` and fill in your key, then restart the dev server.
#
# Get a free key at https://twelvedata.com/apikey
# Free tier: 800 requests/day, 8 requests/minute, up to 5000 bars per request —
# comfortably enough for single-symbol backtesting.
#
# Note: anything prefixed with VITE_ is inlined into the client bundle and is
# therefore visible to anyone who loads the page. That is fine for a personal
# tool running locally. If you ever deploy this publicly, proxy the request
# through a small backend instead of shipping the key to the browser.

VITE_TWELVEDATA_API_KEY=
