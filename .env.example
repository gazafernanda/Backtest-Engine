# Copy this file to `.env` and fill it in. `.env` is gitignored.
#
# Nothing here is ever deployed. A VITE_ variable is inlined into the browser
# bundle, and the Telegram token would let anyone post to your chat, so both the
# web app and the alert bot are meant to run locally.

# ─── Market data ─────────────────────────────────────────────
# Free key: https://twelvedata.com/apikey
# Free tier: 800 requests/day, 8 per minute.
VITE_TWELVEDATA_API_KEY=

# ─── Telegram alerts (npm run bot) ───────────────────────────
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
#    It replies with a token that looks like 123456789:AAH...
# 2. Send any message to your new bot (it cannot message you first).
# 3. Open https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and copy
#    result[0].message.chat.id — that is your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Bot behaviour (all optional) ────────────────────────────
# Seconds between polls. 120 = 720 requests/day, inside the free tier.
BOT_POLL_SECONDS=120

# Ignore setups older than this on startup, so a restart does not replay
# yesterday's signals.
BOT_MAX_SIGNAL_AGE_MINUTES=15

# Set an account size to have each alert include a suggested lot size.
# Leave at 0 to omit sizing from the messages.
BOT_ACCOUNT_SIZE=0
BOT_RISK_PERCENT=1

# BOT_SYMBOL=XAU/USD
# BOT_INTERVAL=1min
# BOT_BARS=500
