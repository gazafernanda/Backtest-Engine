{
  "name": "gold-backtest-engine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke": "esbuild scripts/smoketest.ts --bundle --platform=node --format=cjs --loader:.css=text --outfile=node_modules/.cache/smoketest.cjs --log-level=warning && node node_modules/.cache/smoketest.cjs",
    "bot": "esbuild scripts/bot/index.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/bot.cjs --log-level=warning && node --env-file-if-exists=.env node_modules/.cache/bot.cjs"
  },
  "dependencies": {
    "lightweight-charts": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
